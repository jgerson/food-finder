# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# turbopuffer (required): https://turbopuffer.com/dashboard
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=aws-us-east-1
TURBOPUFFER_NAMESPACE=food101

# Vercel Blob (needed only by `npm run ingest`): Vercel project > Storage > Blob > .env.local tab
BLOB_READ_WRITE_TOKEN=
